FROM archlinux:base

RUN pacman-key --init \
    && pacman -Syu --noconfirm --needed \
      base-devel \
      ca-certificates \
      curl \
      git \
      nodejs \
      npm \
      python \
      unzip \
      uv \
      xz \
    && pacman -Scc --noconfirm

RUN useradd --create-home --shell /bin/bash agentic \
    && install -d -o agentic -g agentic /workspace

WORKDIR /workspace
COPY --chown=agentic:agentic . /workspace

ENV HOME=/home/agentic \
    npm_config_prefix=/home/agentic/.local \
    PATH=/home/agentic/.local/bin:${PATH}

USER agentic

ENTRYPOINT ["/bin/sh", "-c", "cat /etc/os-release; uname -m; id; exec \"$@\"", "--"]
CMD ["/bin/sh", "./docker-smoke-test.sh"]
